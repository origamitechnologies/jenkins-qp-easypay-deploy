pipeline {
    agent any

    environment {
        DEPLOY_HOST = "3.111.88.31"
        DEPLOY_USER = "deploy"
        DEPLOY_PATH = "/opt/ticketbuddy_payments/qp-easypay"
        BRANCH      = "main"
    }

    stages {
        stage('Deploy Sandbox') {
            steps {
                sshagent(credentials: ['git-ssh-ksrtc-deploy']) {
                    sh '''
                    ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_HOST} "
                        set -e
                        cd ${DEPLOY_PATH}

                        echo '📥 Fetching latest code'
                        git fetch origin
                        git reset --hard origin/${BRANCH}
                        git clean -fd

                        echo '🗑️ Clearing Laravel caches'
                        php artisan optimize:clear
                        rm -rf storage/framework/views/*

                        echo '⚡ Optimizing Laravel'
                        php artisan optimize
                    "
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Sandbox deployment successful"
        }
        failure {
            echo "❌ Sandbox deployment failed"
        }
    }
}
